# Reviewed template only: NOT installed in .github/workflows and NOT enabled.
# Before installation, obtain approval for scheduled provider use, public
# normalized snapshots on camera-data, and workflow contents:write permission.
name: Refresh approved state camera directories
on:
  schedule:
    - cron: '17 */6 * * *'
  workflow_dispatch:
permissions:
  contents: read
# Activation requires explicitly approving contents:write for the refresh job.
concurrency:
  group: monitor-approved-camera-directories
  cancel-in-progress: false
jobs:
  refresh:
    if: ${{ false }} # Disabled until review, permission and secure secret setup.
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      # Pin actions/checkout and actions/setup-node to reviewed full commit SHAs
      # during activation. No third-party action receives provider credentials.
      - uses: actions/checkout@v7
        with:
          ref: main
      - uses: actions/setup-node@v7
        with:
          node-version: 22
          package-manager-cache: false
      # No npm install is needed: the fetcher uses built-in Node modules only.
      - name: Arizona directory
        run: node scripts/refresh-state-snapshots.js AZ
        env:
          MTS_AZ_511_API_KEY: ${{ secrets.MTS_AZ_511_API_KEY }}
      - name: Georgia directory
        if: ${{ always() }}
        run: node scripts/refresh-state-snapshots.js GA
        env:
          MTS_GA_511_API_KEY: ${{ secrets.MTS_GA_511_API_KEY }}
      # Wisconsin intentionally omitted until written reuse consent is verified.
